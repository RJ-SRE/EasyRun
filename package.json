{
  "name": "wordrunner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "词境跑者：开发环境与语音诊断工具",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts *.js *.html *.yaml",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.ts *.js *.html *.yaml",
    "test": "pnpm audio:fixture && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm audio:fixture && vitest run --coverage",
    "test:e2e": "pnpm audio:fixture && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "audio:fixture": "node scripts/audio-fixture.mjs",
    "audio:convert": "node scripts/audio-convert.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.5",
    "@xgo-pkgs/spx": "3.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
