// Export-only, read-only combat presentation. No gameplay timers or stats change.
var (
 nativeCombatDirty bool
 nativeCombatKnown bool
 nativeCombatMendTick int
 nativeCombatPhase int
 nativeCombatEmbers int
 nativeCombatBow int
 nativeCombatBlade int
 nativeCombatHeal int
 nativeCombatUltimate int
 nativeCombatBoss bool
 nativeCombatBossLabel int
 nativeCombatBossFill int
 nativeCombatNotice int
 nativeCombatEventId int
 nativeCombatEventTime float64
 nativeCombatSecond int
 nativeCombatScore int
 nativeCombatKills int
 nativeCombatCheckpoint int
 nativeCombatEchoes int
 nativeCombatCombo int
 nativeCombatBest int
 nativeCombatDeaths int
)
func nativeSkillFrame(kind int,cool float64) int {
 base:=31; if kind==4 {base=51}
 if phase==5 && wordPending==kind {return base}
 if kind==1 && Hero.bowCharging {if Hero.bowCharge>=0.55 {return base+2}; return base+1}
 if kind==2 && Hero.charging {if Hero.chargeTime>=0.55 {return base+2}; return base+1}
 if kind==3 && Hero.healTime>0 || kind==4 && Hero.ultimateTime>0 {return base+3}
 if cool>0 {return int(clamp(math.Ceil(cool*10),1,float64(base-1)))}
 if bindTime>0 {return base+7}
 if kind==3 {if !Hero.grounded {return base+6}; if health>=maxHealth {return base+4}; if embers<=0 {return base+5}}
 return 0
}
func nativeCombatEvent(name string) {
 if name=="start" || name=="practice" || name=="retry" || name=="menu" || name=="finish" || name=="fail" {nativeCombatEventId=0; nativeCombatEventTime=0; return}
 if phase!=1 {return}
 id:=0
 if name=="armor" {id=9}; if name=="guardbreak" {id=10}; if name=="wardbreak" {id=11}
 if name=="healground" {id=12}; if name=="healfull" {id=13}; if name=="healempty" {id=14}
 if name=="checkpoint" {id=15}; if name=="echo" {id=16}; if name=="keepermendbreak" {id=17}; if name=="keepermend" {id=18}
 if id>0 && (id!=nativeCombatEventId || nativeCombatEventTime<=0) {nativeCombatEventId=id; nativeCombatEventTime=1.6}
}
func updateNativeCombat(dt float64) {
 if phase==1 && nativeCombatEventTime>0 {nativeCombatEventTime=math.Max(0,nativeCombatEventTime-dt)}
 visible:=phase==1 || phase==5
 changed:=!nativeCombatKnown || nativeCombatPhase!=phase
 nativeCombatPhase=phase; nativeCombatKnown=true
 if visible {
  e:=int(clamp(float64(embers),0,2))*5+int(clamp(float64(emberHits),0,4))
  if embers>=2 {e=14}
  bow:=nativeSkillFrame(1,Hero.bowCool); blade:=nativeSkillFrame(2,Hero.bladeCool)
  heal:=nativeSkillFrame(3,Hero.healCool); ultimate:=nativeSkillFrame(4,Hero.ultimateCool)
  boss:=(phase==1 || phase==5) && segment==1 && enemyHP[keeperIndex]>0 && !nativeHelp && !nativePreview
  label:=int(clamp(float64(bossStage),0,2))*40
  state:=enemyState[keeperIndex]
  if state==6 {label+=1} else if state==2 {label+=2} else if state==5 {label+=3} else if bossMove>=0 && bossMove<9 {
   label+=4+bossMove*3; if state!=1 {label+=2} else if bossLocked==1 {label++}
  }
  if state==7 {label=int(clamp(float64(bossStage),0,2))*40+34; if bossMendAge>=2.0 {label++}; if bossMendHits>0 {label=int(clamp(float64(bossStage),0,2))*40+36}}
  mendTick:=int(bossMendAge*10); if mendTick!=nativeCombatMendTick {nativeCombatMendTick=mendTick; nativeTextMemoKnown=false; changed=true}
  fill:=0; if bossMaxHP>0 {fill=int(clamp(math.Ceil(float64(enemyHP[keeperIndex])*100/float64(bossMaxHP)),0,100))}
  notice:=0
  if phase==1 {
   if bindTime>0 {notice=1} else if chainOwner>=0 {notice=2; if wordMode==1 && practice==0 {notice=3}} else if nativeCombatEventTime>0 {notice=nativeCombatEventId} else if Hero.bowCharging {notice=4; if Hero.bowTarget>=0 {notice=5}} else if Hero.charging && Hero.chargeTime>=0.55 {notice=6} else if !Hero.grounded && Hero.airAttacks>=2 {notice=7} else if !Hero.grounded && Hero.airAttacks==1 {notice=8}
  }
  changed=changed || e!=nativeCombatEmbers || bow!=nativeCombatBow || blade!=nativeCombatBlade || heal!=nativeCombatHeal || ultimate!=nativeCombatUltimate || boss!=nativeCombatBoss || label!=nativeCombatBossLabel || fill!=nativeCombatBossFill || notice!=nativeCombatNotice
  nativeCombatEmbers=e; nativeCombatBow=bow; nativeCombatBlade=blade; nativeCombatHeal=heal; nativeCombatUltimate=ultimate; nativeCombatBoss=boss; nativeCombatBossLabel=label; nativeCombatBossFill=fill; nativeCombatNotice=notice
 }
 // Retain statistics for pause/results without rebuilding hidden battle text.
 if phase==1 || phase==2 || phase==3 || phase==4 {
  second:=int(elapsed)
  chain:=0; if combo>=2 && comboTime>0 {chain=combo}
  summaryChanged:=second!=nativeCombatSecond || score!=nativeCombatScore || kills!=nativeCombatKills || checkpoint!=nativeCombatCheckpoint || echoes!=nativeCombatEchoes || bestCombo!=nativeCombatBest || deaths!=nativeCombatDeaths
  if chain!=nativeCombatCombo || phase!=1 && summaryChanged {nativeTextMemoKnown=false}
  nativeCombatSecond=second; nativeCombatScore=score; nativeCombatKills=kills; nativeCombatCheckpoint=checkpoint; nativeCombatEchoes=echoes; nativeCombatCombo=chain; nativeCombatBest=bestCombo; nativeCombatDeaths=deaths
 }
 nativeCombatDirty=changed
}
func nativeCombatTime() string {m:=nativeCombatSecond/60; s:=nativeCombatSecond%60; if s<10 {return fmt.Sprint(m,":0",s)}; return fmt.Sprint(m,":",s)}
func nativeDrawCombatText() {
 if nativeHelp || nativePreview {return}
 if (phase==1 || phase==5) && segment==1 && enemyState[keeperIndex]==7 && enemyHP[keeperIndex]>0 {
  x:=330.0; y:=109.0; if phase==5 {x=610; y=255}
  nativeText(fmt.Sprintf("回流 %.1fs · 断印 %d/2",math.Max(0,bossMendDuration-bossMendAge),bossMendHits),x,y,11)
 }
 if phase==1 {
  if nativeCombatCombo>=2 {nativeText(fmt.Sprint("连续击破 ×",nativeCombatCombo),530,531,12)}
 } else if phase==2 || phase==3 || phase==4 {
  y:=304.0; if phase==4 {y=347}
  nativeText(fmt.Sprint("用时 ",nativeCombatTime()," · 得分 ",nativeCombatScore),64,y,13)
  nativeText(fmt.Sprint("击破 ",nativeCombatKills," · 连斩最佳 ",nativeCombatBest," · 回声 ",nativeCombatEchoes,"/3"),64,y+22,12)
  if phase!=4 {nativeText(fmt.Sprint("倒下 ",nativeCombatDeaths," 次 · 检查点 ",nativeCombatCheckpoint+1),64,y+44,12)}
 }
}
