onCloned data => {
 p:=data.([]float64); age:=0.0; x:=p[0]; y:=p[1]; vx:=p[2]; vy:=p[3]
 setXYpos x,y; setHeading angle(vx,vy); show
 for age<4.5 && int(p[4])==attempts && phase!=2 && phase!=3 {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if phase==1 {
   age+=dt; x+=vx*dt; y+=vy*dt; setXYpos x,y
   if Hero.attackTime>0 && dist(x-Hero.px,y-Hero.py-28)<105 {age=5; energy+=4; if energy>100 {energy=100}; burst(x,y,4,0,150); event("parry")} else if dist(x-Hero.px,y-Hero.py-28)<25 {hurt(1); age=5}
   if x<75 || x>885 {age=5; burst(x,y,4,1,90)}
  }
 }
 die
}
