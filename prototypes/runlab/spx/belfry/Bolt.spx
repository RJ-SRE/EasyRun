onCloned data => {
 p:=data.([]float64); age:=0.0; x:=p[0]; y:=p[1]; vx:=p[2]; vy:=p[3]; kind:=int(p[5]); pinned:=false
 setCostume kind; setXYpos x,y; setHeading angle(vx,vy); show
 for age<3.2 && int(p[4])==attempts && phase!=2 && phase!=3 {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if len(p)>6 && (int(p[6])!=keeperEpoch || segment!=1) {die}
  if phase==1 && hitStop<=0 {
   age+=dt
   if !pinned {
    oldX:=x; oldY:=y; x+=vx*dt; y+=vy*dt; setXYpos x,y
    contact:=lineDistance(Hero.px,Hero.py+28,oldX,oldY,x,y)
    if Hero.attackTime>0 && contact<105 {
     age=4; energy+=4; if energy>100 {energy=100}; burst(x,y,4,0,150); event("parry")
    } else if contact<24 {hurt(1); age=4}
    wall:=x<92 || x>868
    if practice==0 {for j:=0;j<len(floorX);j++ {if floorKind[j]<2 && x>floorX[j] && x<floorX[j]+floorW[j] && ((oldY>floorY[j] && y<=floorY[j]) || (oldY<floorY[j]-18 && y>=floorY[j]-18)) {wall=true}}}
    if wall {pinned=true; age=2.55; burst(x,y,3,1,80)}
   } else {setGraphicEffect GhostEffect,(age-2.55)/0.65*100}
  }
 }
 die
}
