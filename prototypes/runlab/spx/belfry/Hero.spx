import "math"

var (
 healGated bool
 ultimateGated bool
 bladeLink int
 px float64
 py float64
 vx float64
 vy float64
 facing float64
 grounded bool
 airJump bool
 coyote float64
 buffer float64
 dropTime float64
 hook int
 target int
 ropeLength float64
 hookCool float64
 hookAge float64
 hookX float64
 hookY float64
 dashTime float64
 dashCool float64
 basicCool float64
 airAttacks int
 airHitSlow bool
 bowRecoil float64
 bowCool float64
 bladeCool float64
 healCool float64
 ultimateCool float64
 bowTarget int
 bowInputX float64
 bowInputY float64
 bowCharging bool
 bowCharge float64
 prevBow bool
 prevHeal bool
 healTime float64
 ultimateTime float64
 ultimateStep int
 aimX float64
 aimY float64
 bladeX float64
 bladeY float64
 ultimateDir float64
 attackKind int
