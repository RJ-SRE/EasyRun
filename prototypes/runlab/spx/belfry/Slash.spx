onCloned data => {
 p:=data.([]float64); age:=0.0
 setCostume int(p[3]); setXYpos p[0],p[1]; setHeading p[2]; setSize 0.4; setGraphicEffect GhostEffect,0; show
 for age<0.24 && int(p[4])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if phase!=4 {age+=dt; t:=clamp(age/0.24,0,1); setSize 0.6+t*0.55; setGraphicEffect GhostEffect,t*t*100; setXYpos Hero.px,Hero.py+32}
 }
 die
}
