onCloned data => {
 slot:=data.(int); previous:=-1; blend:=0.0; lastAttempt:=-1; trailAt:=0.0; view:=-1
 for {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  i:=sceneEnemies[slot]; if i<0 {hide
   continue
  }
  if view!=i {view=i; previous=-1; blend=0; lastAttempt=-1; trailAt=0}
  if enemyHP[i]>0 && enemyType[i]!=6 && abs(enemyY[i]-cameraY)<700 {
   show; kind:=enemyType[i]; atlas:=kind; if kind==3 {atlas=1}; if kind>3 {atlas=kind-1}
   pose:=0; state:=enemyState[i]; t:=enemyClock[i]
   if state==0 && abs(enemyVX[i])>22 {pose=int(enemyStride[i]/16)%2}
   if state==1 {pose=2}
   if state==2 {pose=4; if kind==1 || kind==3 || kind==5 {pose=0}}
   if state==3 {pose=3; if (kind==1 || kind==3) && t>0.63 {pose=4}; if kind==4 && chainOwner==i {pose=4}}
   if state==4 {pose=4}
   if state==5 {pose=1; if kind==5 {pose=2}}
   if enemyStun[i]>0 {pose=5}
   costume:=atlas*6+pose; size:=0.25; if kind==3 {size=0.34}
   if kind==1 && enemyStun[i]<=0 {
    if state==3 && enemyMode[i]==0 && t>0.25 && t<0.60 {costume=30; if t>=0.37 {costume=31}}
    if enemyMode[i]==1 {
     if state==5 {costume=32}
     if state==1 {costume=33; if t>0.32 {costume=34}}
     if state==3 {costume=35; if t<0.10 {costume=34}; if t>0.36 {costume=36}; if t>0.60 {costume=10}}
     if state==2 && t<0.45 {costume=37; if t<0.18 {costume=36}}
    }
   }
   if kind==2 && enemyMode[i]==1 && state==3 && enemyStun[i]<=0 {costume=38; if t>0.22 && t<0.62 {costume=39}; if t>0.78 {costume=16}}
   if kind==4 && enemyMode[i]==1 && enemyStun[i]<=0 {if state==1 {costume=40}; if state==3 {costume=41; if t>0.42 {costume=40}}}
   if kind==3 {
    pose=0; if state==0 && abs(enemyVX[i])>25 {pose=1}; if state==1 {pose=2}; if state==2 {pose=5}; if state==3 {pose=3}; if state==5 || state==3 && (bossMove==2 || bossMove==5) {pose=4}
    if state==6 {pose=2; if t>0.40 {pose=4}; if t>0.85 {pose=5}}
    costume=42+bossStage*6+pose; size=0.38
   }
   if lastAttempt!=attempts {previous=costume; lastAttempt=attempts; blend=0; trailAt=0}
   if costume!=previous {
    if previous>=0 && takeFX(80) { EnemyBlend.clone []float64{float64(i),float64(previous),enemyFacing[i]*90,size,float64(attempts)}}
    previous=costume; blend=0.065; setCostume costume
   }
   setCostume costume; setHeading enemyFacing[i]*90
   breath:=0.0; if state==0 {breath=sin(visualTime*2.3+float64(i))*0.004}
   setSize size*(1+breath); setXYpos enemyX[i],enemyY[i]-34
   // Stationary silhouettes mark actual past positions; they never hit or hide
   // the body. The same pool and attempt/pause lifetime rules bound the cost.
   fast:=state==5 || (state==3 && enemyMode[i]==1 && (kind==1 || kind==2)) || (kind==3 && state==3 && (bossMove==1 || bossMove==4 || bossMove==5))
   if fast && enemyStun[i]<=0 && abs(enemyVX[i])>130 && phase==1 && elapsed-trailAt>0.065 && takeFX(70) {
    trailAt=elapsed; EnemyBlend.clone []float64{float64(i),float64(costume),enemyFacing[i]*90,size,float64(attempts),enemyX[i],enemyY[i]-34,0.18}
   }
   ghost:=0.0; if phase==1 || phase==5 {blend=clamp(blend-presentationDelta(dt),0,0.065)}; if blend>0 {ghost=blend/0.065*35}
   if kind==2 && state==0 {ghost=25}
   setGraphicEffect GhostEffect,ghost
   light:=8.0; if state==1 {light=12}
   flash:=enemyFlash[i]; if phase==5 {flash=clamp(flash-wordFocusAge*0.28,0,1)}
   if flash>0 {light=58}
   setGraphicEffect BrightnessEffect,light
  } else {hide; previous=-1}
 }
}
