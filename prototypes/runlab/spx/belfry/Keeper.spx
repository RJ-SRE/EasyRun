// Structural Keeper: nine physical weapon moves, three distinct silhouettes.
// Targets are observed positions, never keyboard state. Eight reusable segments.
func clearKeeperDanger() {
 keeperEpoch++
 for j:=0;j<len(keeperLife);j++ {keeperLife[j]=0; keeperSpent[j]=0; keeperToken[j]=-1}
}
func resetKeeper() {
 bossMaxHP=72; if difficulty==1 {bossMaxHP=90}
 skillCastSerial=0; bossMendAge=0; bossMendDuration=9.5; bossMendCooldown=8; bossMendPulse=0; bossMendHealed=0; bossMendHits=0; bossMendPressure=0; bossMendUsed=[]int{0,0,0}; bossMendCasts=nil
 bossMove=-1; bossLastMove=-1; bossDecision=0; bossChain=0; bossLocked=0; bossPoise=0; bossOpening=-1; bossStroke=0; bossAirCooldown=0; bossRecent=nil; bossBladeX=0; bossBladeY=0
 keeperAX=make([]float64,8); keeperAY=make([]float64,8); keeperBX=make([]float64,8); keeperBY=make([]float64,8)
 keeperPrevAX=make([]float64,8); keeperPrevAY=make([]float64,8); keeperPrevBX=make([]float64,8); keeperPrevBY=make([]float64,8)
 keeperAge=make([]float64,8); keeperDelay=make([]float64,8); keeperLife=make([]float64,8); keeperWidth=make([]float64,8)
 keeperStyle=make([]int,8); keeperSpent=make([]int,8); keeperToken=make([]int,8); clearKeeperDanger()
}
// Kept for shared diagnostics. Normal attacks exclusively use tracked weapons.
func keeperLine(ax,ay,bx,by,delay,life,width float64,style int) {
 for j:=0;j<len(keeperLife);j++ {if keeperLife[j]<=0 {
  keeperAX[j]=ax; keeperAY[j]=ay; keeperBX[j]=bx; keeperBY[j]=by
  keeperPrevAX[j]=ax; keeperPrevAY[j]=ay; keeperPrevBX[j]=bx; keeperPrevBY[j]=by
  keeperAge[j]=0; keeperDelay[j]=delay; keeperLife[j]=life; keeperWidth[j]=width; keeperStyle[j]=style; keeperSpent[j]=0; keeperToken[j]=-1; return
 }}
}
func keeperTrack(j int,ax,ay,bx,by,width float64,style int) {
 if keeperToken[j]!=bossStroke {keeperSpent[j]=0; keeperPrevAX[j]=ax; keeperPrevAY[j]=ay; keeperPrevBX[j]=bx; keeperPrevBY[j]=by; keeperToken[j]=bossStroke} else {
  keeperPrevAX[j]=keeperAX[j]; keeperPrevAY[j]=keeperAY[j]; keeperPrevBX[j]=keeperBX[j]; keeperPrevBY[j]=keeperBY[j]
 }
 keeperAX[j]=ax; keeperAY[j]=ay; keeperBX[j]=bx; keeperBY[j]=by
 keeperAge[j]=0; keeperDelay[j]=0; keeperLife[j]=0.055; keeperWidth[j]=width; keeperStyle[j]=style
}
func updateKeeperDanger(dt float64) {
 if segment!=1 || enemyHP[keeperIndex]<=0 {return}
 for j:=0;j<len(keeperLife);j++ {
  if keeperLife[j]<=0 {
 continue
}; keeperAge[j]+=dt
  if keeperAge[j]>=keeperDelay[j] && keeperAge[j]<=keeperDelay[j]+keeperLife[j] && keeperStyle[j]!=2 && keeperSpent[j]==0 {
   px:=Hero.px; py:=Hero.py+28; d:=10000.0
   // Sample the swept shaft, including its previous position. This catches a
   // fast tip without making the whole rectangular sweep a damage zone.
   for n:=0;n<=4;n++ {u:=float64(n)/4; ax:=keeperPrevAX[j]+(keeperAX[j]-keeperPrevAX[j])*u; ay:=keeperPrevAY[j]+(keeperAY[j]-keeperPrevAY[j])*u; bx:=keeperPrevBX[j]+(keeperBX[j]-keeperPrevBX[j])*u; by:=keeperPrevBY[j]+(keeperBY[j]-keeperPrevBY[j])*u; d=math.Min(d,lineDistance(px,py,ax,ay,bx,by))}
   d=math.Min(d,lineDistance(px,py,keeperPrevBX[j],keeperPrevBY[j],keeperBX[j],keeperBY[j]))
   if d<keeperWidth[j]+15 {before:=health; hurt(1); if health<before {keeperSpent[j]=1; shock=math.Min(shock,3); hitStop=math.Min(hitStop,0.03); burst(px,py,7,1,150)}}
  }
  if keeperAge[j]>keeperDelay[j]+keeperLife[j]+0.07 {keeperLife[j]=0}
 }
}
func keeperFloor(x,y float64) int {
 best:=enemyFloor[keeperIndex]; top:=enemyBaseY[keeperIndex]-34
 for j:=0;j<len(floorX);j++ {if floorActive(j) && x>floorX[j]+28 && x<floorX[j]+floorW[j]-28 && floorY[j]>=top && floorY[j]<=y+14 && floorY[j]<=enemyBaseY[keeperIndex]+250 {best=j; top=floorY[j]}}
 return best
}
func keeperSetPosition(i int,x,y,dt float64) {
 enemyVX[i]=(x-enemyX[i])/math.Max(dt,0.001); enemyVY[i]=(y-enemyY[i])/math.Max(dt,0.001)
 enemyStride[i]+=abs(x-enemyX[i]); enemyX[i]=x; enemyY[i]=y; enemyOffX[i]=x-enemyBaseX[i]; enemyOffY[i]=y-enemyBaseY[i]
}
func keeperRest(duration float64) {
 i:=keeperIndex; enemyVX[i]=0; enemyVY[i]=0; enemyStun[i]=0; enemyHazard[i]=0; bossPoise=0
 if difficulty==1 {duration*=0.9}; enemyRecoverFor(i,duration); enemyEvent("keeperopen",i)
}
func keeperAim() {
 i:=keeperIndex; enemyAimX[i]=clamp(Hero.px+Hero.vx*0.10,125,835); enemyAimY[i]=clamp(Hero.py+28,enemyBaseY[i]-6,enemyBaseY[i]+320)
 enemyFacing[i]=1; if enemyAimX[i]<enemyX[i] {enemyFacing[i]=-1}
}
func keeperWindup(move int) float64 {
 durations:=[]float64{0.85,0.95,1.05,0.65,0.80,0.75,0.95,0.90,1.10}; duration:=durations[move]
 if difficulty==1 {duration*=0.88}; return duration
}
func keeperChoose() int {
 i:=keeperIndex; dx:=abs(Hero.px-enemyX[i]); dy:=Hero.py+28-enemyY[i]
 move:=bossStage*3+bossDecision%3
 if bossStage==0 {if dx>210 {move=1} else if dy>75 {move=2}}
 if bossStage==1 {if dy>80 && bossAirCooldown<=0 {move=5} else if dx>190 {move=4}; if move==5 && bossAirCooldown>0 {move=3}}
 if bossStage==2 {if abs(dy)>95 || dx>260 {move=7} else if dx>150 {move=6}}
 repeated:=0; for _,m:=range bossRecent {if m==move {repeated++}}
 if repeated>=2 {move=bossStage*3+(move+1)%3; if move==5 && bossAirCooldown>0 {move=3}}
 bossRecent=append(bossRecent,move); if len(bossRecent)>3 {bossRecent=bossRecent[1:]}
 bossDecision++; bossLastMove=move; if move==5 {bossAirCooldown=4.5}; return move
}
func beginKeeperTell(move int) {
 i:=keeperIndex; bossMove=move; bossLocked=0; bossPoise=0; bossWindup=keeperWindup(move)
 enemyMode[i]=move; enemySpent[i]=0; enemyStep[i]=0; enemyStun[i]=0; enemyVX[i]=0; enemyVY[i]=0
 keeperAim(); enterEnemyState(i,1); enemyEvent("keepertell",i)
}
func beginKeeperMove() {prepareKeeperMove(keeperChoose())}
func prepareKeeperMove(move int) {bossChain=0; clearKeeperDanger(); beginKeeperTell(move)}
func lockKeeperAttack() {
 i:=keeperIndex; bossLocked=1; enemyFromX[i]=enemyX[i]; enemyFromY[i]=enemyY[i]
 enemyMoveX[i]=enemyX[i]; enemyMoveY[i]=enemyY[i]
 if bossMove==1 || bossMove==4 {reach:=200.0; if bossMove==4 {reach=240}; enemyMoveX[i]=enemyGroundLimit(i,clamp(enemyX[i]+enemyFacing[i]*reach,125,835))}
 if bossMove==7 {enemyMoveX[i]=clamp(enemyAimX[i]+enemyFacing[i]*35,140,820); if abs(enemyMoveX[i]-enemyX[i])>260 {enemyMoveX[i]=enemyX[i]+enemyFacing[i]*260}; top:=keeperFloor(enemyMoveX[i],enemyAimY[i]-28); enemyMoveY[i]=floorY[top]+34}
 bossBladeX=clamp(enemyX[i]+enemyFacing[i]*250,130,830); bossBladeY=enemyY[i]-12
 enemyEvent("keeperlock",i)
}
func keeperStrokeEvent() {bossStroke++; enemySpent[keeperIndex]=0; enemyEvent("keeperstrike",keeperIndex)}
func keeperCut(j int,t,start,duration,a,b,length,height float64) {
 if t<start || t>start+duration {return}
 u:=clamp((t-start)/duration,0,1); theta:=(a+(b-a)*u)*math.Pi/180; i:=keeperIndex; f:=enemyFacing[i]
 ax:=enemyX[i]+f*12; ay:=enemyY[i]+height
 keeperTrack(j,ax,ay,ax+f*math.Cos(theta)*length,ay+math.Sin(theta)*length,9,0)
}
func keeperFollow(windup float64) {
 i:=keeperIndex; bossChain++; bossLocked=1; bossPoise=0; bossWindup=windup; if difficulty==1 {bossWindup*=0.88}; enemyVX[i]=0; enemyVY[i]=0; enterEnemyState(i,1); enemyEvent("keeperfollow",i)
}
func keeperChain(t,start float64) {
 i:=keeperIndex; u:=t-start; if u<0 || u>1.0 {return}
 handX:=enemyX[i]+enemyFacing[i]*23; handY:=enemyY[i]+35; bx:=bossBladeX; by:=bossBladeY
 if u<0.2 {f:=u/0.2; bx=handX+(bx-handX)*f; by=handY+(by-handY)*f} else if u>0.7 {f:=(u-0.7)/0.3; bx=bx+(handX-bx)*f; by=by+(handY-by)*f}
 // Slack chain never damages; only the taut retrieval does. The actual blade
 // remains attached to the forearm. Four short links form a catenary-like sag.
 sag:=24.0; style:=2; if u>0.7 {sag=0; style=4}
 for j:=0;j<4;j++ {a:=float64(j)/4; b:=float64(j+1)/4; keeperTrack(j+1,handX+(bx-handX)*a,handY+(by-handY)*a-sin(a*math.Pi)*sag,handX+(bx-handX)*b,handY+(by-handY)*b-sin(b*math.Pi)*sag,5,style)}
 keeperTrack(0,bx-enemyFacing[i]*15,by-3,bx+enemyFacing[i]*33,by+7,10,3)
}
func keeperDeflectBlade(px,py,reach,facing float64) bool {
 i:=keeperIndex; if segment!=1 || enemyHP[i]<=0 || enemyState[i]!=3 || !(bossMove==6 || bossMove==8 && bossChain==2) {return false}
 t:=enemyClock[i]; if t<0.2 || t>0.7 || dist(px-bossBladeX,py-bossBladeY)>reach || (bossBladeX-px)*facing< -1500 {return false}
 clearKeeperDanger(); keeperRest(0.8); burst(bossBladeX,bossBladeY,8,1,150); enemyEvent("guardbreak",i); return true
}
func transformKeeper(stage int) {
 i:=keeperIndex; bossMendAge=0; bossMendHits=0; bossMendCasts=nil; bossMendCooldown=math.Max(bossMendCooldown,7)
 bossStage=stage; bossShield=0; bossMove=-1; bossLocked=0; bossChain=0; bossPoise=0; bossOpening=-1; bossRecent=nil
 clearKeeperDanger(); enemyMark[i]=0; enemyStun[i]=0; enemyHazard[i]=0; enemySpent[i]=0; enemyVX[i]=0; enemyVY[i]=0
 enterEnemyState(i,6); event("enrage"); enemyEvent("keeperform",i)
}
func keeperAfterHit(damage int) {
 i:=keeperIndex; limit:=bossMaxHP*2/3; if bossStage==1 {limit=bossMaxHP/3}
 if bossStage<2 && enemyHP[i]<=limit {enemyHP[i]=limit; transformKeeper(bossStage+1); return}
 if damage>=2 && enemyState[i]==1 {bossPoise+=float64(damage); if bossPoise>=5 {clearKeeperDanger(); keeperRest(0.95); enemyEvent("guardbreak",i)}}
}
func keeperBlocksLight(damage int) bool {
 i:=keeperIndex; if enemyState[i]==6 {return true}
 return damage==1 && bossStage==0 && (enemyState[i]==0 || enemyState[i]==1 && enemyClock[i]<bossWindup-0.24) && (Hero.px-enemyX[i])*enemyFacing[i]>0
}
func updateKeeper(dt float64) {
 i:=keeperIndex; if enemyHP[i]<=0 {return}; enemyStun[i]=0; enemyThrown[i]=0
 if segment!=1 || practice==1 {enemyVX[i]=0; enemyVY[i]=0; return}; if enemyState[i]==7 {return}
 bossAirCooldown=math.Max(0,bossAirCooldown-dt); enemyClock[i]+=dt; t:=enemyClock[i]; state:=enemyState[i]
 if state==6 {duration:=1.6; if bossStage==2 {duration=1.9}; if t>=duration {keeperRest(0.55)}; return}
 if state==0 {
  dx:=Hero.px-enemyX[i]; enemyFacing[i]=1; if dx<0 {enemyFacing[i]=-1}
  target:=0.0; if abs(dx)>180 && abs(Hero.py+28-enemyY[i])<90 {target=enemyFacing[i]*105}; if abs(dx)<75 {target=-enemyFacing[i]*55}
  v:=enemyVX[i]+(target-enemyVX[i])*math.Min(1,dt*6); keeperSetPosition(i,enemyGroundLimit(i,enemyX[i]+v*dt),enemyY[i],dt)
  if keeperCanMend() {beginKeeperMend(); return}
  // A non-damaging, committed jump changes footing when the player camps on
  // another ledge. It is not another attack and never tracks mid-flight.
  if t>0.7 && abs(Hero.py+28-enemyY[i])>160 {
   keeperAim(); top:=keeperFloor(enemyAimX[i],Hero.py)
   if abs(floorY[top]+34-enemyY[i])>65 {enemyFromX[i]=enemyX[i]; enemyFromY[i]=enemyY[i]; enemyMoveX[i]=clamp(enemyAimX[i],floorX[top]+35,floorX[top]+floorW[top]-35); enemyMoveY[i]=floorY[top]+34; enemyStep[i]=top; enterEnemyState(i,5); enemyEvent("keepervault",i); return}
  }
  rest:=0.65; if bossStage>0 {rest=0.45}; if t>=rest && bindTime<=0 && controlGrace<=0 && canEnemyAttack(i) {beginKeeperMove()}
 } else if state==5 {
  u:=clamp(t/0.7,0,1); ease:=u*u*(3-2*u); keeperSetPosition(i,enemyFromX[i]+(enemyMoveX[i]-enemyFromX[i])*ease,enemyFromY[i]+(enemyMoveY[i]-enemyFromY[i])*ease+sin(u*math.Pi)*90,dt)
  if u>=1 {enemyFloor[i]=enemyStep[i]; keeperRest(0.55)}
 } else if state==1 {
  if bossLocked==0 {keeperAim(); if t>=bossWindup-0.28 {lockKeeperAttack()}}
  if t>=bossWindup {enterEnemyState(i,3); enemyStep[i]=0; keeperStrokeEvent()}
 } else if state==3 {
  if bossMove==0 {keeperCut(0,t,0,0.16,38,-12,170,-3); if t>0.20 {keeperRest(0.80)}}
  if bossMove==1 || bossMove==4 {
   duration:=0.30; if bossMove==4 {duration=0.26}; u:=clamp(t/duration,0,1); ease:=u*u*(3-2*u)
   keeperSetPosition(i,enemyFromX[i]+(enemyMoveX[i]-enemyFromX[i])*ease,enemyFromY[i],dt)
   if t<=duration {keeperTrack(0,enemyX[i]+enemyFacing[i]*20,enemyY[i]-2,enemyX[i]+enemyFacing[i]*100,enemyY[i]-2,9,0)}
   if t>=duration {keeperRest(0.90)}
  }
  if bossMove==2 {keeperCut(0,t,0,0.20,100,-65,155,15); if t>=0.20 && enemyStep[i]==0 {enemyStep[i]=1; burst(enemyX[i]+enemyFacing[i]*65,enemyY[i]-30,7,2,90); enemyEvent("land",i)}; if t>0.26 {keeperRest(1.15)}}
  if bossMove==3 {if bossChain==0 {keeperCut(0,t,0,0.17,35,-22,150,-2)} else {keeperCut(0,t,0,0.18,-35,45,135,22)}; if t>=0.21 {if bossChain==0 {keeperFollow(0.40)} else {keeperRest(0.90)}}}
  if bossMove==5 {keeperCut(0,t,0,0.20,-60,95,140,14); if t>0.23 {keeperRest(0.90)}}
  if bossMove==6 {keeperChain(t,0); if t>1.04 {keeperRest(0.95)}}
  if bossMove==7 {
   u:=clamp(t/0.35,0,1); ease:=u*u*(3-2*u); keeperSetPosition(i,enemyFromX[i]+(enemyMoveX[i]-enemyFromX[i])*ease,enemyFromY[i]+(enemyMoveY[i]-enemyFromY[i])*ease+sin(u*math.Pi)*115,dt)
   if t>=0.35 && enemyStep[i]==0 {enemyStep[i]=1; enemyFloor[i]=keeperFloor(enemyX[i],enemyY[i]-34); keeperTrack(0,enemyX[i]-55,enemyY[i]-22,enemyX[i]+55,enemyY[i]-22,15,1); burst(enemyX[i],enemyY[i]-30,8,2,110); enemyEvent("land",i)}
   if t>0.42 {keeperRest(1.05)}
  }
  if bossMove==8 {
   if bossChain==0 {keeperCut(0,t,0,0.18,25,-18,165,-6); if t>=0.22 {keeperFollow(0.35); return}}
   if bossChain==1 {keeperCut(0,t,0,0.20,-30,75,155,15); if t>=0.24 {keeperFollow(0.45); return}}
   if bossChain==2 {keeperChain(t,0); if t>1.04 {keeperRest(1.25)}}
  }
 } else if state==2 {enemyVX[i]=0; enemyVY[i]=0; if t>=enemyRecover[i] {bossMove=-1; bossChain=0; enterEnemyState(i,0)}}
 bossHP=enemyHP[i]
}
// Healing advances in real active time during word input; explicit pauses do not.
func keeperMendCap() int {return bossMaxHP*(3-bossStage)/3}
func keeperCanMend() bool {i:=keeperIndex; return segment==1 && practice==0 && bossShield==0 && enemyHP[i]>0 && bossMendCooldown<=0 && bossDecision>=1 && bossMendUsed[bossStage]<2 && enemyHP[i]<=keeperMendCap()-bossMaxHP/10}
func beginKeeperMend() {
 i:=keeperIndex; clearKeeperDanger(); bossMendUsed[bossStage]++; bossMendAge=0; bossMendPulse=0; bossMendHealed=0; bossMendHits=0; bossMendPressure=0; bossMendCasts=nil
 bossMendDuration=9.5; if difficulty==1 {bossMendDuration=8.5}; bossMendCooldown=15; if difficulty==1 {bossMendCooldown=12}
 bossMove=-1; bossLocked=0; bossPoise=0; enemyVX[i]=0; enemyVY[i]=0; enemyHazard[i]=0; enemyStun[i]=0; enterEnemyState(i,7); enemyEvent("keepermend",i); event("keepermend")
}
func updateKeeperMending(dt float64) {
 if segment!=1 || practice!=0 || enemyHP[keeperIndex]<=0 || !(phase==1 || phase==5 && !wordVisualPaused) {return}
 dt=clamp(dt,0,0.1); bossMendCooldown=math.Max(0,bossMendCooldown-dt); i:=keeperIndex; if enemyState[i]!=7 {return}
 bossMendAge+=dt; bossMendPressure=math.Max(0,bossMendPressure-dt)
 if bossMendHits>0 && bossMendPressure<=0 {bossMendHits=0; bossMendCasts=nil; enemyEvent("keepermendreset",i)}
 lead:=2.0; interval:=0.9; if difficulty==1 {lead=1.7; interval=0.8}
 pulses:=int(math.Max(0,math.Floor((math.Min(bossMendAge,bossMendDuration)-lead)/interval)))
 for bossMendPulse<pulses {bossMendPulse++; cap:=keeperMendCap(); budget:=bossMaxHP/10; if enemyHP[i]<cap && bossMendHealed<budget {enemyHP[i]++; bossMendHealed++; enemyEvent("keeperheal",i)}}
 bossHP=enemyHP[i]; if bossMendAge>=bossMendDuration {bossMendHits=0; bossMendCasts=nil; keeperRest(0.65); enemyEvent("keepermendend",i)}
}
func keeperSkillImpact(target,kind,cast int) {
 if target!=keeperIndex || enemyHP[target]<=0 || enemyState[target]!=7 || (kind!=1 && kind!=2 && kind!=4) || cast<=0 {return}
 for _,old:=range bossMendCasts {if old==cast {return}}
 bossMendCasts=append(bossMendCasts,cast); bossMendHits++; bossMendPressure=6; if difficulty==1 {bossMendPressure=5}; enemyEvent("keepermendcrack",target)
 if bossMendHits>=2 {bossMendHits=0; bossMendCasts=nil; bossMendAge=0; clearKeeperDanger(); keeperRest(1.15); enemyEvent("keepermendbreak",target); event("keepermendbreak")}
}
