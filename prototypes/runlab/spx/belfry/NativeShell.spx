// Export-only menu, lifecycle controls and HUD. Art/hit regions share one layout.
var (
 nativeHelp bool
 nativeHelpReturn int
 nativeHover int
 nativePanel int
 nativeUiLogTime float64
 nativeDragging int
 nativeLayerVersion int
 nativeLayerCache string
 nativeHitCache string
 nativeHitX float64
 nativeHitY float64
)
func nativeButtonVisible(action int) bool {
 if nativeHintOpen && phase==0 && !nativeHelp && !nativePreview {return action>=30 && action<=33}
 if nativePreview && nativeLedgerFilterOpen && action>=27 && action<=29 {return true}
 if nativePreview {return action==26 || action==19 && nativePreviewPage>0 || action==20 && nativePreviewPage+1<len(nativeLedgerPages) || action==22 || action==23 || action==24 || action==25}
 if action==6 {return phase!=1 && phase!=5}
 if action==21 {return phase==1 && practice==0 && wordMode==1 && !nativeHelp}
 if action==17 || action==18 {return phase!=1 && phase!=5 && !nativeHelp}
 if action>=12 && action<=16 {return phase==0 && !nativeHelp}
 if action==30 {return phase==0 && !nativeHelp}
 if nativeHelp {return action==9}
 if action==10 || action==11 {return false}
 if action==1 {return phase==0 || phase==2 || phase==3 || phase==4}
 if action==2 || action==4 || action==5 {return phase==0}
 if action==3 {return phase==0 || phase==4}
 if action==7 {return phase==2 || phase==3 || phase==4}
 if action==8 {return phase==2 || phase==3}
 return false
}
func nativeActionAt(x,y float64) int {
 for a:=1;a<=33;a++ {
  if nativeButtonVisible(a) {
   bx,by,bw,bh:=nativeButtonRect(a)
   if x>=bx && x<=bx+bw && y>=by && y<=by+bh {return a}
  }
 }
 return 0
}
func nativeCloseHelp() {nativeHelp=false; phase=nativeHelpReturn}
func nativeToggleHelp() {
 if phase==5 || nativePreview {return}
 if nativeHelp {nativeCloseHelp(); return}
 nativeHelpReturn=phase; nativeHelp=true
 if phase==1 {phase=4}
}
func nativeConfirm() {
 nativeHintOpen=false
 if phase==5 {nativeSubmit(); return}
 if nativePreview {if nativeLedgerFilterOpen {nativeLedgerFilterOpen=false} else {nativeCloseLedger()}; return}
 if nativeHelp {nativeCloseHelp(); return}
 if phase==4 {phase=1} else if phase==3 {retryCheckpoint()} else if phase==0 || phase==2 {startRun()}
}
func nativePause() {
 if nativeHintOpen {nativeHintOpen=false; return}
 if nativePreview {if nativeLedgerFilterOpen {nativeLedgerFilterOpen=false} else {nativeCloseLedger()}; return}
 if phase==5 {wordVisualPaused=!wordVisualPaused; return}
 if nativeHelp {nativeCloseHelp(); return}
 if phase==1 {phase=4} else if phase==4 {phase=1}
}
func nativeReturnTitle() {
 if phase==4 || phase==2 || phase==3 {
  nativeHelp=false; practice=0; resetInscription(); Hero.cancelAttack(); phase=0; event("menu")
 }
}
func nativeActivate(action int) {
 if action==0 {nativeHintOpen=false; if nativePreview {nativeLedgerFilterOpen=false}; return}
 println "@nativeAction",action
 if action==1 {nativeConfirm()}
 if action==2 {startPractice()}
 if action==3 || action==11 {nativeToggleHelp()}
 if action==4 {difficulty=0; event("difficulty")}
 if action==5 {difficulty=1; event("difficulty")}
 if action==6 {nativeMusicMuted=!nativeMusicMuted}
 if action==7 {nativeReturnTitle()}
 if action==8 {startRun()}
 if action==9 {if nativePreview {nativeCloseLedger()} else {nativeCloseHelp()}}
 if action==12 {nativeScope=(nativeScope+1)%3; nativeShuffleDeck()}
 if action==13 {wordMode=1-wordMode}
 if action==14 {nativePace=(nativePace+1)%3}
 if action==15 || action==21 {nativeOpenLedger()}
 if action==16 {nativeShuffleDeck()}
 if action==17 || action==18 {nativeDragging=action; nativeAdjustVolume(action)}
 if action==19 {nativeLedgerPage(-1)}
 if action==20 {nativeLedgerPage(1)}
 if action==10 {nativePause()}
 if action==22 {nativeLedgerFilterOpen=!nativeLedgerFilterOpen; nativeLedgerSearch=false}
 if action==23 {nativeLedgerSearch=true; nativeLedgerFilterOpen=false}
 if action==24 {nativeLedgerFilterOpen=false; nativeLedgerQuery=""; nativeFilterLedger(); nativeLedgerSearch=true}
 if action==25 || action==26 {nativeCloseLedger()}
 if action>=27 && action<=29 {nativeLedgerFilter=action-27; nativeLedgerFilterOpen=false; nativeFilterLedger()}
 if action==30 {nativeHintOpen=!nativeHintOpen}
 if action>=31 && action<=33 {nativeHint=action-31; nativeHintOpen=false}
}
func nativeAdjustVolume(action int) {
 x:=mouseX-viewCenterX+480
 v:=int(clamp(math.Floor((x-656)/224*100+0.5),0,100))
 if action==17 {nativeMusicVolume=v; nativeMusicMuted=false} else {nativeSfxVolume=v}
 println "@nativeVolume",nativeMusicVolume,nativeSfxVolume
}
func updateNativeShell(dt float64) {
 if nativeDragging>0 {if mousePressed && nativeButtonVisible(nativeDragging) {nativeAdjustVolume(nativeDragging)} else {nativeDragging=0}}
 // Rebuild text before the layer pass; newly cloned glyphs share this epoch.
 updateNativeWords(dt)
 nativePanel=-1
 if phase==0 {nativePanel=difficulty}
 if phase==4 {nativePanel=3}
 if phase==3 {nativePanel=4}
 if phase==2 {nativePanel=5}
 if nativeHelp {nativePanel=2}
 if nativePreview {nativePanel=6}
 pointerX:=mouseX-viewCenterX+480; pointerY:=viewCenterY-mouseY+300
 hitCache:=fmt.Sprint(nativePanel,phase,nativeHelp,nativePreview,nativePreviewPage,len(nativeLedgerPages),nativeLedgerFilterOpen,nativeHintOpen,wordMode,practice)
 if hitCache!=nativeHitCache || pointerX!=nativeHitX || pointerY!=nativeHitY {
  nativeHitCache=hitCache; nativeHitX=pointerX; nativeHitY=pointerY
  nativeHover=nativeActionAt(pointerX,pointerY)
 }
 layerCache:=fmt.Sprint(nativePanel,nativeHover,nativePreview,nativeHelp,nativeHintOpen,nativeLedgerFilterOpen,nativeTextVersion,phase,wordVisualPaused)
 if layerCache!=nativeLayerCache {nativeLayerCache=layerCache; nativeLayerVersion++}
 NativeHUD.syncUI(); NativeHealth.syncUI(); NativeObjective.syncUI()
 NativeSkill0.syncUI(); NativeSkill1.syncUI(); NativeSkill2.syncUI(); NativeSkill3.syncUI()
 NativePanel.syncUI(); NativeLedgerTools.syncUI(); NativeMusicButton.syncUI()
 // Paint the hover once in its final layer; cached Front calls cannot be
 // repeated below and above a dropdown in the same epoch.
 overlayHover:=nativeHintOpen || nativeLedgerFilterOpen && nativeHover>=27
 if !overlayHover {NativeHover.syncUI()}
 NativeMusicSlider.syncUI(); NativeSfxSlider.syncUI(); NativeQuestion.syncUI(); NativeQuestionTimer.syncUI(); NativeSpellingTrack.syncUI()
 nativePaintText()
 NativeLedgerFilter.syncUI(); NativeHintMenu.syncUI()
 if overlayHover {NativeHover.syncUI()}
 NativeLedgerTally0.syncUI(); NativeLedgerTally1.syncUI(); NativeLedgerTally2.syncUI(); NativeLedgerTally3.syncUI(); NativeLedgerTally4.syncUI(); NativeLedgerTally5.syncUI(); NativeLedgerTally6.syncUI(); NativeLedgerTally7.syncUI(); NativeLedgerTally8.syncUI(); NativeLedgerTally9.syncUI();
 NativeMatte0.syncUI(); NativeMatte1.syncUI(); NativeMatte2.syncUI(); NativeMatte3.syncUI()
 nativeUiLogTime+=dt
 if nativeUiLogTime>0.25 {
  nativeUiLogTime=0
  println "@nativeUI",nativePanel,nativeHover,viewCenterX,viewCenterY,viewWidth,viewHeight,Camera.zoom,nativeTextCount,nativeGlyphLive
 }
}
