// Export-only menu, lifecycle controls and HUD. Art/hit regions share one layout.
var (
 nativeHelp bool
 nativeHelpReturn int
 nativeHover int
 nativePanel int
 nativeUiLogTime float64
 nativeDragging int
)
func nativeButtonVisible(action int) bool {
 if action==6 {return phase!=1 && phase!=5}
 if nativePreview {return action==9 || action==19 || action==20}
 if action==17 || action==18 {return phase!=1 && phase!=5 && !nativeHelp}
 if action>=12 && action<=16 {return phase==0 && !nativeHelp}
 if nativeHelp {return action==9}
 if action==10 || action==11 {return false}
 if action==1 {return phase==0 || phase==2 || phase==3 || phase==4}
 if action==2 || action==4 || action==5 {return phase==0}
 if action==3 {return phase==0 || phase==4}
 if action==7 {return phase==2 || phase==3 || phase==4}
 if action==8 {return phase==2 || phase==3}
 return false
}
func nativeActionAt(x,y float64) int {
 for a:=1;a<=20;a++ {
  if nativeButtonVisible(a) {
   bx,by,bw,bh:=nativeButtonRect(a)
   if x>=bx && x<=bx+bw && y>=by && y<=by+bh {return a}
  }
 }
 return 0
}
func nativeCloseHelp() {nativeHelp=false; phase=nativeHelpReturn}
func nativeToggleHelp() {
 if phase==5 || nativePreview {return}
 if nativeHelp {nativeCloseHelp(); return}
 nativeHelpReturn=phase; nativeHelp=true
 if phase==1 {phase=4}
}
func nativeConfirm() {
 if phase==5 {nativeSubmit(); return}
 if nativePreview {nativePreview=false; return}
 if nativeHelp {nativeCloseHelp(); return}
 if phase==4 {phase=1} else if phase==3 {retryCheckpoint()} else if phase==0 || phase==2 {startRun()}
}
func nativePause() {
 if nativePreview {nativePreview=false; return}
 if phase==5 {wordVisualPaused=!wordVisualPaused; return}
 if nativeHelp {nativeCloseHelp(); return}
 if phase==1 {phase=4} else if phase==4 {phase=1}
}
func nativeReturnTitle() {
 if phase==4 || phase==2 || phase==3 {
  nativeHelp=false; practice=0; resetInscription(); Hero.cancelAttack(); phase=0; event("menu")
 }
}
func nativeActivate(action int) {
 if action==0 {return}
 println "@nativeAction",action
 if action==1 {nativeConfirm()}
 if action==2 {startPractice()}
 if action==3 || action==11 {nativeToggleHelp()}
 if action==4 {difficulty=0; event("difficulty")}
 if action==5 {difficulty=1; event("difficulty")}
 if action==6 {nativeMusicMuted=!nativeMusicMuted}
 if action==7 {nativeReturnTitle()}
 if action==8 {startRun()}
 if action==9 {if nativePreview {nativePreview=false} else {nativeCloseHelp()}}
 if action==12 {nativeScope=(nativeScope+1)%3; nativeShuffleDeck()}
 if action==13 {wordMode=1-wordMode}
 if action==14 {nativePace=(nativePace+1)%3}
 if action==15 {nativePreview=true; nativePreviewPage=0}
 if action==16 {nativeShuffleDeck()}
 if action==17 || action==18 {nativeDragging=action; nativeAdjustVolume(action)}
 if action==19 {nativePreviewPage=(nativePreviewPage+9)%10}
 if action==20 {nativePreviewPage=(nativePreviewPage+1)%10}
 if action==10 {nativePause()}
}
func nativeAdjustVolume(action int) {
 x:=mouseX-viewCenterX+480
 v:=int(clamp(math.Floor((x-656)/224*100+0.5),0,100))
 if action==17 {nativeMusicVolume=v; nativeMusicMuted=false} else {nativeSfxVolume=v}
 println "@nativeVolume",nativeMusicVolume,nativeSfxVolume
}
func updateNativeShell(dt float64) {
 if nativeDragging>0 {if mousePressed && nativeButtonVisible(nativeDragging) {nativeAdjustVolume(nativeDragging)} else {nativeDragging=0}}
 nativePanel=-1
 if phase==0 {nativePanel=difficulty}
 if phase==4 {nativePanel=3}
 if phase==3 {nativePanel=4}
 if phase==2 {nativePanel=5}
 if nativeHelp {nativePanel=2}
 if nativePreview {nativePanel=6}
 nativeHover=nativeActionAt(mouseX-viewCenterX+480,viewCenterY-mouseY+300)
 NativeHUD.syncUI(); NativeHealth.syncUI(); NativeObjective.syncUI()
 NativeSkill0.syncUI(); NativeSkill1.syncUI(); NativeSkill2.syncUI(); NativeSkill3.syncUI()
 NativePanel.syncUI(); NativeMusicButton.syncUI(); NativeHover.syncUI()
 NativeMusicSlider.syncUI(); NativeSfxSlider.syncUI(); NativeQuestion.syncUI(); NativeQuestionTimer.syncUI()
 updateNativeWords(dt)
 NativeMatte0.syncUI(); NativeMatte1.syncUI(); NativeMatte2.syncUI(); NativeMatte3.syncUI()
 nativeUiLogTime+=dt
 if nativeUiLogTime>0.25 {
  nativeUiLogTime=0
  println "@nativeUI",nativePanel,nativeHover,viewCenterX,viewCenterY,viewWidth,viewHeight,Camera.zoom,nativeTextCount,nativeGlyphLive
 }
}
