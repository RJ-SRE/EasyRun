onCloned data => {
 p:=data.([]float64); age:=0.0
 setXYpos p[0],p[1]; setCostume int(p[2]); setHeading p[3]; setGraphicEffect GhostEffect,65; setGraphicEffect BrightnessEffect,38; show
 for age<0.22 && int(p[4])==attempts {
  dt:=float64(waitNextFrame()); if phase!=4 {dt=presentationDelta(dt); age+=dt; setGraphicEffect GhostEffect,65+clamp(age/0.22,0,1)*35}
 }
 die
}
