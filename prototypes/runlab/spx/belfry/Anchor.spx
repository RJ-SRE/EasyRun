onCloned data => {
 i:=data.(int); setXYpos anchorX[i],anchorY[i]; show
 for {
  waitNextFrame()
  if Hero.target==i {setCostume "chosen"; setSize 1.12+sin(worldTime*6)*0.05} else {setCostume "idle"; setSize 1}
  if segment==1 && bossShield>0 {if i==14 && !sealLeft || i==15 && !sealRight {setCostume "seal"; setSize 1.3+sin(worldTime*5)*0.06}}
  setHeading 90+sin(worldTime+float64(i))*4
 }
}
