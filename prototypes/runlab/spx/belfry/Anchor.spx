onCloned data => {
 slot:=data.(int); previousCostume:=-1
 for {
  waitNextFrame()
  i:=sceneAnchors[slot]; if i<0 {hide
   continue
  }
  setXYpos anchorX[i],anchorY[i]; show
  costume:=0
  if Hero.target==i {costume=2; setSize 1.12+sin(visualTime*6)*0.05} else {setSize 1}
  if segment==1 && bossShield>0 {if i==sealA && !sealLeft || i==sealB && !sealRight {costume=1; setSize 1.3+sin(visualTime*5)*0.06}}
  if costume!=previousCostume {previousCostume=costume; setCostume costume}
  setHeading 90+sin(visualTime+float64(i))*4
 }
}
