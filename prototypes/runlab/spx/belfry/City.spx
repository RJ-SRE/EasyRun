// Persistent environmental decisions. Only the simulation may alter routes.
func resetCity() {
 cityWind=0; cityForge=0; cityArchive=0; cityMirror=0; cityChoice=0
 cityDistrict=0; cityPrompt=-1; cityClock=0; cityDepth=0
}
func districtAt(y float64) int {
 if y > -740 {return 0}; if y > -1530 {return 1}; if y > -2340 {return 2}; if y > -3070 {return 3}; return 4
}
func floorActive(i int) bool {
 kind:=floorKind[i]
 if kind==1 && segment==2 {return false}
 if kind==2 && enemyHP[2]<=0 || kind==3 && enemyHP[6]<=0 {return false}
 if kind==4 && cityMirror==0 || kind==5 && cityForge==0 || kind==6 && cityArchive==0 {return false}
 return true
}
func cityCandidate() int {
 if phase!=1 || practice==1 || !Hero.grounded || bindTime>0 || chainOwner>=0 || Hero.attackTime>0 || Hero.charging || Hero.bowCharging || Hero.healTime>0 || Hero.ultimateTime>0 {return -1}
 for i:=0;i<5;i++ {
  if abs(Hero.px-cityNodeX[i])<108 && abs(Hero.py-cityNodeY[i])<42 {
   if i==0 && cityWind==0 || i==1 && cityForge==0 || i==2 && cityArchive==0 || i==3 && cityMirror==0 || i==4 && cityChoice==0 && segment==0 {return i}
  }
 }
 return -1
}
func interactCity(option int) {
 i:=cityCandidate(); if i<0 || option==2 && i!=4 {return}
 if i==0 {cityWind=1; event("citywind")}
 if i==1 {cityForge=1; event("cityforge")}
 if i==2 {cityArchive=1; event("cityarchive")}
 if i==3 {cityMirror=1; event("citymirror")}
 if i==4 {cityChoice=option; if option==1 {event("cityshare")} else {event("citycarry")}}
 ring(cityNodeX[i],cityNodeY[i]+45,1.2,1); burst(cityNodeX[i],cityNodeY[i]+45,12,1,180)
 cityPrompt=-1
}
func updateCity(dt float64) {
 if practice==1 {cityDistrict=0; cityPrompt=-1; return}
 cityClock+=dt
 // Lift uses combat time, not the visual clock. A standing passenger is carried
 // before Hero.update records its previous position for one-way collision.
 old:=floorY[17]
 floorY[17]=-1360+(1-cos(cityClock*0.8))*160
 if cityForge==1 && Hero.grounded && abs(Hero.py-old)<2 && Hero.px+12>floorX[17] && Hero.px-12<floorX[17]+floorW[17] {Hero.py+=floorY[17]-old}
 cityDistrict=districtAt(Hero.py)
}
