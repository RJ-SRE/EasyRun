// City systems share the authored expedition coordinates.
func resetCity() {
 cityWind=0; cityForge=0; cityArchive=0; cityMirror=0; cityChoice=0
 cityDistrict=0; cityPrompt=-1; cityClock=0; cityDepth=0; weightClock=0; weightRange=0.45
}
func districtAt(y float64) int {
 for i:=0;i<len(districtEdges);i++ {if y>districtEdges[i] {return i}}
 return 4
}
func floorActive(i int) bool {
 kind:=floorKind[i]
 if kind==1 && segment==2 {return false}
 if kind>=100 {return segment!=2 && roomDone[kind-100]==0}
 if kind==61 {return sideProgress[1]>=2}
 if kind>=60 && kind<65 {return segment==2 && sideProgress[kind-60]>=2}
 if kind==70 {return segment==2 && sideProgress[0]>=2}
 if kind==42 {return roomHas(6,1)}
 if kind==43 {return roomHas(3,1) || roomHas(3,2)}
 if kind==40 || kind==41 {return mirrorChoice==kind-39}
 if kind>=20 && kind<40 {
  r:=kind-20
  if r==2 {return roomHas(r,1)}
  if r==3 {return roomHas(r,1) || roomHas(r,2)}
 }
 return true
}
func cityCandidate() int {return -1}
func interactCity(option int) {interactExpedition(option)}
func updateCity(dt float64) {
 if practice==1 {cityDistrict=0; cityPrompt=-1; return}
 cityClock+=dt
 if sideProgress[0]==0 {
  i:=courierFloor; oldX:=floorX[i]; center:=220+sin(cityClock*0.8)*95
  floorX[i]=center-90; nodeX[courierNode]=center
  if Hero.grounded && abs(Hero.py-floorY[i])<2 && Hero.px+12>oldX && Hero.px-12<oldX+floorW[i] {Hero.px+=floorX[i]-oldX}
 }
 for j:=0;j<len(liftFloor);j++ {
  i:=liftFloor[j]; old:=floorY[i]; oldX:=floorX[i]
  if liftRoom[j]==2 {floorX[i]=420; if segment==2 && cargoChoice>0 {floorX[i]=180; if cargoChoice==2 {floorX[i]=570}}}
  if floorActive(i) {
   clock:=cityClock
   if liftRoom[j]==3 {
    weightClock+=dt; clock=weightClock; extent:=0.45
    if roomHas(3,1) && roomHas(3,2) {extent=1}
    weightRange+=clamp(extent-weightRange,-dt*0.6,dt*0.6)
   }
   travel:=(1-cos(clock*6.283/liftPeriod[j]))/2
   if liftRoom[j]==3 {travel*=weightRange}
   floorY[i]=liftLow[j]+travel*(liftHigh[j]-liftLow[j])
   if Hero.grounded && abs(Hero.py-old)<2 && Hero.px+12>floorX[i] && Hero.px-12<floorX[i]+floorW[i] {Hero.py+=floorY[i]-old; Hero.px+=floorX[i]-oldX}
   if liftRoom[j]==3 {
    c:=counterweightFloor; before:=floorY[c]; floorY[c]=liftLow[j]+liftHigh[j]-floorY[i]
    if Hero.grounded && abs(Hero.py-before)<2 && Hero.px+12>floorX[c] && Hero.px-12<floorX[c]+floorW[c] {Hero.py+=floorY[c]-before}
   }
  }
 }
 cityDistrict=districtAt(Hero.py)
}
