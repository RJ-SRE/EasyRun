// Authored room tasks. All progress is simulation-owned; only presentation
// continues while inscription input freezes the world.
func roomAt(y float64) int {
 for r:=0;r<len(roomBottom);r++ {if y>=roomBottom[r] {return r}}
 return len(roomBottom)-1
}
func roomHas(r,bit int) bool {return roomFlags[r]/bit%2==1}
func nodeDone(i int) bool {
 if nodeSide[i]>=0 {return sideProgress[nodeSide[i]]>nodeStep[i]}
 return roomHas(nodeRoom[i],int(math.Pow(2,float64(nodeStep[i]))))
}
func finishRoom(r int) {
 if roomDone[r]==1 {return}
 roomDone[r]=1; event("roomcomplete")
 ring(Hero.px,Hero.py+36,0.8,1)
}
func resetExpedition() {
 expRoom=0; expPrompt=-1; decoyTime=0; decoyNode=-1; cargoChoice=0; mirrorChoice=0; recordChoice=0
 lampStep=0; lampMoving=0; lampClock=0; lampSafe=0; lampX=nodeX[lampStart]; lampY=nodeY[lampStart]+58
 trialHooks=0; trialStarted=0; trialAt=0; lastExpHook=-1; repairRouteUsed=false
 for r:=0;r<len(roomFlags);r++ {roomFlags[r]=0; roomDone[r]=0}
 for i:=0;i<len(sideProgress);i++ {sideProgress[i]=0}
 for i:=0;i<len(trialVisited);i++ {trialVisited[i]=0}
 for i:=0;i<len(heatState);i++ {heatState[i]=0}
}
func setExpNode(i int) {
 if nodeDone(i) {return}
 if nodeSide[i]>=0 {sideProgress[nodeSide[i]]=nodeStep[i]+1; event("sideprogress")} else {roomFlags[nodeRoom[i]]+=int(math.Pow(2,float64(nodeStep[i])))}
 for j:=0;j<len(enemyNode);j++ {if enemyNode[j]==i {enemyHP[j]=0}}
 ring(nodeX[i],nodeY[i]+34,0.8,1); burst(nodeX[i],nodeY[i]+34,10,1,160)
 event("mechanism")
}
func expeditionCandidate() int {
 if phase!=1 || practice==1 || !Hero.grounded || bindTime>0 || chainOwner>=0 || Hero.attackTime>0 || Hero.charging || Hero.bowCharging || Hero.healTime>0 || Hero.ultimateTime>0 {return -1}
 best:=-1; distance:=110.0
 for i:=0;i<len(nodeX);i++ {
  if !nodeDone(i) && abs(Hero.py-nodeY[i])<44 && abs(Hero.px-nodeX[i])<distance {
   k:=nodeKind[i]; eligible:=true
   if nodeSide[i]>=0 {eligible=sideProgress[nodeSide[i]]==nodeStep[i]}
   if k==3 {eligible=roomHas(2,1)}
   if k==6 {eligible=roomHas(3,1) && roomHas(3,2)}
   if k==13 || k==14 {eligible=lampMoving==0 && lampStep==nodeStep[i]}
   if k==17 {eligible=roomHas(8,1) && roomHas(8,2)}
   if k==22 {eligible=mirrorChoice>0}
   if k==19 || k==20 {eligible=enemyHP[hunterLeft]<=0 && enemyHP[hunterRight]<=0}
   if k==8 || k==9 {eligible=segment==0 && enemyHP[foremanIndex]>0}
   if k==23 {eligible=segment==0 && cityChoice==0}
   if eligible {best=i; distance=abs(Hero.px-nodeX[i])}
  }
 }
 return best
}
func interactExpedition(option int) {
 i:=expeditionCandidate(); if i<0 {return}
 k:=nodeKind[i]; r:=nodeRoom[i]
 if option==2 && k!=3 && k!=17 && k!=21 && k!=23 {return}
 // The two weights are reusable bait, not completion buttons. A committed
 // chain striking a weight staggers the foreman at the actual collision.
 if k==8 || k==9 {decoyNode=i; decoyTime=3; ring(nodeX[i],nodeY[i]+40,1,2); event("weightbait"); return}
 if k==12 || k==13 {
  if lampMoving==1 || nodeStep[i]!=lampStep {return}
  setExpNode(i); lampMoving=1; lampClock=0; lampSafe=lampStep; event("lampstart"); return
 }
 if nodeSide[i]==3 {
  if nodeStep[i]==0 {trialStarted=1; trialHooks=0; trialAt=elapsed; lastExpHook=-1; for a:=0;a<len(trialVisited);a++ {trialVisited[a]=0}}
  if nodeStep[i]==1 && trialHooks<3 {event("trialincomplete"); return}
 }
 if nodeSide[i]==1 && nodeStep[i]==1 {
  blocked:=false
  for j:=0;j<len(enemyHP);j++ {if enemyHP[j]>0 && enemyType[j]!=6 && abs(enemyX[j]-nodeX[i])<210 && abs(enemyY[j]-nodeY[i])<170 {blocked=true}}
  if blocked {event("repairblocked"); return}
 }
 setExpNode(i)
 if nodeSide[i]>=0 && nodeStep[i]==1 {
  if nodeSide[i]==0 {event("couriercomplete")}
  if nodeSide[i]==1 {event("repaircomplete")}
  if nodeSide[i]==2 {event("indexcomplete")}
  if nodeSide[i]==3 {event("trialcomplete")}
  if nodeSide[i]==4 {event("lanterncomplete")}
 }
 if k==1 {finishRoom(r)}
 if k==3 {cargoChoice=option; cityWind=1; finishRoom(r); event("citywind")}
 if k==6 {cityForge=1; finishRoom(r); event("cityforge")}
 if k==7 {finishRoom(r)}
 if k==10 {cityArchive=1; event("cityarchive")}
 if k==14 {finishRoom(r); event("lampcomplete")}
 if k==17 {recordChoice=option; cityArchive=1; finishRoom(r); event("records")}
 if k==18 {finishRoom(r)}
 if k==19 || k==20 {if roomHas(r,1) && roomHas(r,2) {finishRoom(r)}}
 if k==21 {mirrorChoice=option; cityMirror=1; event("citymirror")}
 if k==22 {finishRoom(r)}
 if k==23 {cityChoice=option; finishRoom(r); if option==1 {event("cityshare")} else {event("citycarry")}}
 expPrompt=-1
}
func updateExpedition(dt float64) {
 if practice==1 {expPrompt=-1; return}
 expRoom=roomAt(Hero.py); expPrompt=expeditionCandidate()
 if segment==2 && sideProgress[1]>=2 && !repairRouteUsed && Hero.grounded {
  for i:=0;i<len(floorKind);i++ {
   if floorKind[i]==61 && abs(Hero.py-floorY[i])<2 && Hero.px>=floorX[i] && Hero.px<=floorX[i]+floorW[i] {repairRouteUsed=true; event("repairroute")}
  }
 }
 if segment==0 {
  if expRoom>checkpoint {
   checkpoint=expRoom; event("checkpoint")
   // Save every room; full supplies belong to region entrances and the final
   // antechamber. Retrying still restores health, without repeat room healing.
   if expRoom%3==0 || expRoom==14 {health=maxHealth; event("restored")}
  }
  for r:=0;r<len(roomBottom);r++ {
   if r==0 || r==4 || r==6 || r==9 || r==12 {if Hero.py<roomBottom[r]+80 {finishRoom(r)}}
  }
  if enemyHP[foremanIndex]<=0 {finishRoom(5)}
  if roomFlags[13]==7 {finishRoom(13)}
  if expRoom==14 && Hero.py<roomTop[14]-130 {segment=1; event("guardian")}
 }
 if trialStarted==1 && expRoom>=9 && expRoom<=11 && Hero.hook>=0 && Hero.hookAge>=0.045 && Hero.hook<len(anchorX) && trialVisited[Hero.hook]==0 {
  trialHooks++; lastExpHook=Hero.hook; trialVisited[Hero.hook]=1
 }
 if decoyTime>0 {
  decoyTime-=dt; i:=foremanIndex
  if enemyHP[i]>0 && enemyState[i]==3 && enemyMode[i]!=1 && enemyClock[i]>0.34 && enemyClock[i]<0.65 && abs(enemyAimX[i]-nodeX[decoyNode])<150 && abs(enemyAimY[i]-nodeY[decoyNode]-32)<100 {
   if chainOwner==i {chainOwner=-1; chainTime=0}
   enemyStun[i]=0.85; enemyRecoverFor(i,1.6); decoyTime=0; burst(enemyX[i],enemyY[i],18,1,240); event("weightcounter")
  }
 }
 // Escort follows three authored segments. It waits at each safe platform,
 // and a nearby committed strike sends it only to the previous safe stop.
 if lampMoving==1 {
  target:=lampStart+lampStep+1; dx:=nodeX[target]-lampX; dy:=nodeY[target]+58-lampY; d:=dist(dx,dy)
  step:=math.Min(d,160*dt); if d>0.1 {lampX+=dx/d*step; lampY+=dy/d*step}
  lampClock+=dt
  if lampClock>0.7 {
   for j:=0;j<len(enemyHP);j++ {
    if enemyHP[j]>0 && enemyType[j]!=6 && enemyState[j]==3 && dist(enemyX[j]-lampX,enemyY[j]-lampY)<95 {
     lampMoving=0; lampStep=lampSafe; lampX=nodeX[lampStart+lampSafe]; lampY=nodeY[lampStart+lampSafe]+58
     bit:=int(math.Pow(2,float64(lampStep))); if roomHas(7,bit) {roomFlags[7]-=bit}; event("lampreturn"); break
    }
   }
  }
  if lampMoving==1 && d<6 {lampMoving=0; lampStep++; event("lampdock")}
 }
 for i:=0;i<len(heatX);i++ {
  state:=0; cycle:=math.Mod(cityClock+heatOffset[i],5.6)
  if !roomHas(heatRoom[i],1) && segment!=2 {if cycle>2.5 {state=1}; if cycle>3.4 && cycle<4.7 {state=2}}
  heatState[i]=state
  if state==2 && abs(Hero.px-heatX[i])<heatWidth[i]/2+12 && Hero.py+48>heatY[i] && Hero.py<heatY[i]+127*heatWidth[i]/106 {hurt(4)}
 }
}
func expeditionReturn() {
 roomDone[14]=1; segment=2; checkpoint=14; health=maxHealth; returnTime=0; riseY=worldBottom-430; energy=100
 if cityChoice==1 {health=maxHealth-1} else {embers=2; emberHits=0}
 for j:=0;j<len(enemyHP);j++ {
  if enemyReturnOnly[j]==0 && enemyFloor[j]>=0 && floorKind[enemyFloor[j]]==1 {enemyHP[j]=0}
  if enemyReturnOnly[j]==1 {clearEnemyMotion(j); enemyHP[j]=enemyMaxHP(enemyType[j]); enemyState[j]=0; enemyClock[j]=0}
 }
 event("core")
}
func restoreExpedition() {
 for i:=0;i<len(roomFlags);i++ {roomFlags[i]=hostRoomFlags[i]; roomDone[i]=hostRoomDone[i]}
 for i:=0;i<len(sideProgress);i++ {sideProgress[i]=hostSideProgress[i]}
 cargoChoice=hostCargoChoice; mirrorChoice=hostMirrorChoice; recordChoice=hostRecordChoice
 // Restore at a supported room entry, never in the middle of an escort flight.
 lampStep=hostLampStep; lampMoving=0; lampSafe=lampStep; lampX=nodeX[lampStart+lampStep]; lampY=nodeY[lampStart+lampStep]+58
 if lampStep<3 {bit:=int(math.Pow(2,float64(lampStep))); if roomHas(7,bit) {roomFlags[7]-=bit}}
 for i:=0;i<len(enemyHP);i++ {
  if enemyReturnOnly[i]==0 && enemyRoom[i]<checkpoint {enemyHP[i]=0}
  if enemyNode[i]>=0 {if nodeDone(enemyNode[i]) {enemyHP[i]=0}}
 }
 if sideProgress[3]>0 {trialStarted=1; trialHooks=0}
}
