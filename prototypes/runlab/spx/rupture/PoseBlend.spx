onCloned data => {
 p:=data.([]float64); age:=0.0
 setCostume int(p[0]); setHeading p[3]; setGraphicEffect GhostEffect,55; setXYpos Hero.px,Hero.renderY; show
 for age<p[1] && int(p[2])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.04 {dt=0.04}
  if phase!=4 {
   age+=dt; t:=age/p[1]; if t>1 {t=1}
   setXYpos Hero.px,Hero.renderY; setGraphicEffect GhostEffect,55+t*45
  }
 }
 die
}
