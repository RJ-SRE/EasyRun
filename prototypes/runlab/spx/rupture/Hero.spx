var (
 px float64
 py float64
 vx float64
 vy float64
 grounded bool
 coyote float64
 buffer float64
 dashTime float64
 prevJump bool
 prevAction bool
 trailAt float64
 animationClock float64
 runDistance float64
 oldLiftY float64
 onLift bool
 pose int
 blendTime float64
 blendDuration float64
 bodyOffset float64
 bodyVelocity float64
 renderY float64
 facing float64
 landing float64
 stepIndex int
)
func resetHero() {
 px=150; py=-150; vx=0; vy=0; grounded=true; coyote=0.12; buffer=0; dashTime=0
 prevJump=false; prevAction=false; trailAt=0; animationClock=0; runDistance=0; onLift=false; oldLiftY=liftY
 pose=0; blendTime=0; bodyOffset=0; bodyVelocity=0; facing=90; landing=0; stepIndex=0; renderY=py
 setXYpos px,py; setCostume "idle"; setGraphicEffect GhostEffect,0
 cameraX=480; cameraY=0; cameraRenderX=480; cameraRenderY=0; Camera.setXYpos 480,0
}
func action() {
 if energy==1 {
  energy=0; launches++; dashTime=0.46; grounded=false; coyote=0; onLift=false; shock=2.5
  if keyPressed(KeyW)||keyPressed(KeyUp) {vx=760; vy=730} else {vx=1120; vy=560}
  Pulse.clone []float64{px,py+32,1.4,0,float64(attempts)}
  burst(px-8,py+32,12,0,210)
  bodyVelocity=-30; event("launch")
 } else {
  if abs(px-1000)<380 && abs(py+40)<270 && rotorCool<=0 {
   energy=1; steals++; score+=150; rotorCool=9; bridgeBroken=true; bridgeDelay=1.0; shock=2.8
   capture(1000,-40); event("turbine")
  } else if abs(px-2160)<320 && abs(py-liftY)<260 && liftCool<=0 {
   energy=1; steals++; score+=150; liftCool=9; shock=2.2
   capture(2160,liftY); event("lift")
  } else {event("empty")}
 }
}
func animateHero(dt float64) {
 next:=0
 if dashTime>0.08 {next=14} else if !grounded {
  if vy>100 {next=13} else {next=15}
 } else if landing>0.07 && abs(vx)<450 {next=16} else if abs(vx)>30 {next=int(runDistance/14)%12+1}
 if next!=pose {
  duration:=0.055
  if next>=1 && next<=12 && pose>=1 && pose<=12 {duration=0.022}
  PoseBlend.clone []float64{float64(pose),duration,float64(attempts),facing}
  pose=next; blendDuration=duration; blendTime=duration; setCostume pose
 }
 if blendTime>0 {blendTime-=dt; if blendTime<0 {blendTime=0}; setGraphicEffect GhostEffect,blendTime/blendDuration*45} else {setGraphicEffect GhostEffect,0}
 bodyVelocity+=(-210*bodyOffset-23*bodyVelocity)*dt
 bodyOffset+=bodyVelocity*dt
 renderY=py+bodyOffset
 if grounded && abs(vx)<20 {renderY+=sin(worldTime*2.6)*0.7}
 setXYpos px,renderY
 if vx < -15 {facing=-90} else if vx>15 {facing=90}
 setHeading facing
}
onStart => {
 for {
  dt:=float64(waitNextFrame()); if dt>0.04 {dt=0.04}
  if phase==1 {
   animationClock+=dt
   wasGrounded:=grounded
   jump:=keyPressed(KeySpace)||keyPressed(KeyW)||keyPressed(KeyUp)
   act:=keyPressed(KeyE)||keyPressed(KeyShift)
   if jump && !prevJump {buffer=0.14}
   if act && !prevAction {action()}
   if !jump && prevJump && vy>220 && dashTime<=0 {vy*=0.58}
   prevJump=jump; prevAction=act
   if grounded {coyote=0.12} else {coyote-=dt}
   if buffer>0 {buffer-=dt}
   if buffer>0 && coyote>0 {
    vy=640; buffer=0; coyote=0; grounded=false; onLift=false; bodyVelocity=-38
    impact(px,py,0.45); event("jump")
   }
   if dashTime>0 {dashTime-=dt} else {
    target:=0.0
    if keyPressed(KeyD)||keyPressed(KeyRight) {target=330}
    if keyPressed(KeyA)||keyPressed(KeyLeft) {target=-280}
    accel:=2100.0; if !grounded {accel=850}
    // Approach the requested speed without snapping after a powered launch.
    if vx<target {vx+=accel*dt; if vx>target {vx=target}}
    if vx>target {vx-=accel*dt; if vx<target {vx=target}}
   }
   if onLift && grounded {py+=liftY-oldLiftY}
   oldLiftY=liftY
   oldY:=py
   px+=vx*dt; vy-=1650*dt; if vy < -1000 {vy=-1000}; py+=vy*dt
   fallSpeed:=-vy
   grounded=false; onLift=false
   if vy<=0 {
    for i:=0;i<len(floorX);i++ {
     top:=floorY[i]
     if px+13>floorX[i] && px-13<floorX[i]+floorW[i] && oldY>=top-3 && py<=top {py=top; vy=0; grounded=true}
    }
    if px+13>670 && px-13<1340 && oldY>=bridgeY-3 && py<=bridgeY {py=bridgeY; vy=0; grounded=true}
    if px+13>2070 && px-13<2250 && oldY>=liftY-8 && py<=liftY {py=liftY; vy=0; grounded=true; onLift=true}
   }
   if grounded && !wasGrounded && fallSpeed>100 {
    strength:=fallSpeed/650; if strength>1.4 {strength=1.4}
    landing=0.17; bodyVelocity=-85*strength; shock=1.2*strength
    impact(px,py,strength); event("land")
   }
   if landing>0 {landing-=dt}
   if grounded {
    runDistance+=abs(vx)*dt
    step:=int(runDistance/69)
    if step!=stepIndex && abs(vx)>80 {
     stepIndex=step
     particle(px-5,py+2,-vx*0.15,35+noise()*30,0.19,0.4,3,0,380)
     particle(px-8,py+3,-vx*0.09,12,0.27,0.45,2,0,0)
     event("step")
    }
   }
   dx:=px-1000; dy:=py+38+40
   if rotorCool<=0 && dx*dx+dy*dy<156*156 {failRun(4)}
   if styleCount==0 && abs(px-2350)<42 && py>35 && py<115 {styleCount=1; score+=500; burst(2350,90,20,1,160); event("echo")}
   if px<40 {px=40; vx=0}
   if py < -420 {failRun(1)}
   if px>3240 {finishRun()}
   targetX:=px+190+abs(vx)*0.06; if targetX<480 {targetX=480}; if targetX>2920 {targetX=2920}
   cameraX+=(targetX-cameraX)*(1-exp(-11*dt))
   targetY:=0.0; if py>45 {targetY=(py-45)*0.3}; if targetY>55 {targetY=55}
   cameraY+=(targetY-cameraY)*(1-exp(-5*dt))
   cameraRenderX=cameraX+sin(worldTime*91)*shock
   cameraRenderY=cameraY+sin(worldTime*73)*shock*0.45
   Camera.setXYpos cameraRenderX,cameraRenderY
   animateHero(dt)
   if dashTime>0 && animationClock-trailAt>0.035 {
    trailAt=animationClock; Trail.clone []float64{px,renderY,float64(attempts)}
    particle(px-30,py+35,-140-noise()*180,noise()*40-20,0.25,0.8+noise(),0,0,0)
   }
  } else if phase==0 {animateHero(dt)}
 }
}
