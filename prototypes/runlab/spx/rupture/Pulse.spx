onCloned data => {
 p:=data.([]float64); age:=0.0
 setCostume int(p[3]); setXYpos p[0],p[1]; setSize 0.12; setGraphicEffect GhostEffect,10; show
 for age<0.48 && int(p[4])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.04 {dt=0.04}
  if phase!=4 {
   age+=dt; t:=age/0.48; if t>1 {t=1}
   setSize p[2]*(0.15+(1-(1-t)*(1-t))*1.8)
   setGraphicEffect GhostEffect,15+t*85
  }
 }
 die
}
