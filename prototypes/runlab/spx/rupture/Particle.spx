onCloned data => {
 p:=data.([]float64)
 x:=p[0]; y:=p[1]; vx:=p[2]; vy:=p[3]; age:=0.0
 setCostume int(p[6]); setXYpos x,y; setSize p[5]; setGraphicEffect GhostEffect,0; show
 for age<p[4] && int(p[9])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.04 {dt=0.04}
  if phase!=4 {
   age+=dt; x+=vx*dt; y+=vy*dt; vy-=p[8]*dt
   vx*=1-dt*1.3
   t:=age/p[4]; if t>1 {t=1}
   setXYpos x,y; setGraphicEffect GhostEffect,t*t*100
   if int(p[6])==2 {setSize p[5]*(0.65+t*1.8)} else {setSize p[5]*(1-t*0.45)}
   setHeading 90+p[7]*age
  }
 }
 fxCount--; die
}
