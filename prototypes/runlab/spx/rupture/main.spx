var (
 phase int
 elapsed float64
 worldTime float64
 score int
 combo int
 bestCombo int
 energy int
 attempts int
 steals int
 launches int
 styleCount int
 failReason int
 rotorCool float64
 rotorAngle float64
 rotorSpeed float64
 liftCool float64
 liftY float64
 liftClock float64
 bridgeY float64
 bridgeDelay float64
 bridgeBroken bool
 shock float64
 cameraX float64
 cameraY float64
 cameraRenderX float64
 cameraRenderY float64
 fxCount int
 fxSeed int
 collapseStarted bool
 bridgeSpeed float64
 floorX []float64
 floorW []float64
 floorY []float64
 lastState float64
)
func event(name string) {println "@event",name,elapsed,Hero.px}
func noise() float64 {fxSeed=(fxSeed*73+41)%997; return float64(fxSeed)/997}
func particle(x,y,vx,vy,life,scale float64,kind int,spin,gravity float64) {
 if fxCount<100 {fxCount++; Particle.clone []float64{x,y,vx,vy,life,scale,float64(kind),spin,gravity,float64(attempts)}}
}
func burst(x,y float64,count,kind int,force float64) {
 for i:=0;i<count;i++ {
  a:=noise()*6.283; speed:=force*(0.35+noise()*0.65)
  particle(x,y,sin(a)*speed,cos(a)*speed,0.22+noise()*0.45,0.45+noise()*0.85,kind,noise()*200-100,180)
 }
}
func impact(x,y,strength float64) {
 Pulse.clone []float64{x,y+2,0.7+strength*0.6,1,float64(attempts)}
 for i:=0;i<12;i++ {
  sign:=1.0; if i%2==0 {sign=-1}
  particle(x,y+3,sign*(40+noise()*120)*strength,25+noise()*110*strength,0.2+noise()*0.3,0.35+noise()*0.6,3,0,420)
 }
 for i:=0;i<4;i++ {particle(x,y+5,(noise()-0.5)*130,12+noise()*35,0.38+noise()*0.3,0.8+noise(),2,0,-8)}
}
func capture(x,y float64) {
 Pulse.clone []float64{x,y,2.3,0,float64(attempts)}
 burst(x,y,16,1,270)
 for i:=0;i<9;i++ {Flux.clone []float64{x,y,float64(i)*0.024,(float64(i)-4)*18,float64(attempts)}}
}
func resetRun() {
 phase=1; elapsed=0; worldTime=0; score=0; energy=0; steals=0; launches=0; styleCount=0; failReason=0
 rotorCool=0; liftCool=0; rotorAngle=0; rotorSpeed=230; liftClock=0; liftY=-155; bridgeY=-150; bridgeDelay=0; bridgeBroken=false; shock=0; collapseStarted=false; bridgeSpeed=0
 attempts++; Hero.resetHero(); event("start")
}
func failRun(reason int) {
 if phase==1 {phase=3; failReason=reason; shock=12; event("fail")}
}
func finishRun() {
 if phase==1 {phase=2; score+=int(90-elapsed)*10; event("finish")}
}
onKey KeyR, => {resetRun()}
onKey KeyEnter, => {if phase==4 {phase=1} else if phase!=1 {resetRun()}}
onKey KeyEscape, => {if phase==1 {phase=4} else if phase==4 {phase=1}}
onStart => {
 floorX=[]float64{0,1340,2220,2530,2680}
 floorW=[]float64{670,640,220,80,720}
 floorY=[]float64{-150,-100,40,-40,-150}
 bridgeY=-150; liftY=-155; cameraX=480; rotorSpeed=230; fxSeed=137
 Hero.resetHero()
 for {
  dt:=float64(waitNextFrame()); if dt>0.04 {dt=0.04}
  if phase==1 || phase==0 {
   worldTime+=dt
   targetSpeed:=230.0
   if rotorCool>0 {rotorCool-=dt; targetSpeed=0}
   rotorSpeed+=(targetSpeed-rotorSpeed)*dt*13
   rotorAngle+=rotorSpeed*dt
   if liftCool>0 {liftCool-=dt} else {liftClock+=dt; liftY=-155+sin(liftClock*1.5)*105}
  }
  if phase==1 {
   elapsed+=dt
   if elapsed>90 {failRun(3)}
   if bridgeBroken {
    bridgeDelay-=dt
    if bridgeDelay>0 {bridgeY-=12*dt} else if bridgeY > -650 {
     if !collapseStarted {
      collapseStarted=true; event("collapse")
      burst(690,bridgeY,12,1,180); burst(1310,bridgeY,12,1,180)
      for i:=0;i<9;i++ {particle(710+float64(i)*70,bridgeY-25,noise()*50-25,-30-noise()*40,1.1,0.7+noise(),4,noise()*150-75,330)}
     }
     bridgeSpeed+=280*dt; if bridgeSpeed>280 {bridgeSpeed=280}; bridgeY-=bridgeSpeed*dt
    }
   }
   if shock>0 {shock-=dt*40; if shock<0 {shock=0}}
  }
  if float64(timer)-lastState>0.06 {
   lastState=float64(timer)
   println "@state",phase,elapsed,score,combo,bestCombo,energy,Hero.px,Hero.py,attempts,steals,launches,styleCount,failReason,0,0,0,0,0,0,rotorCool,liftCool,bridgeY,liftY,Hero.vx,Hero.vy,cameraX,cameraY,Hero.pose,Hero.bodyOffset,fxCount,rotorSpeed
  }
 }
}
