import "math"
var (
 phase int
 difficulty int
 checkpoint int
 attempts int
 deaths int
 collected int
 hookCount int
 wallJumps int
 failReason int
 fxCount int
 fxSeed int
 elapsed float64
 worldTime float64
 lastState float64
 cameraX float64
 cameraY float64
 cameraRenderX float64
 cameraRenderY float64
 shock float64
 foldTime float64
 liftTime float64
 windStage int
 floorX []float64
 floorY []float64
 floorBaseY []float64
 floorW []float64
 floorKind []int
 floorDelta []float64
 wallX []float64
 wallY []float64
 wallW []float64
 wallH []float64
 wallKind []int
 wallGate []int
 anchorX []float64
 anchorY []float64
 anchorBaseX []float64
 anchorKind []int
 anchorMode []int
 switchDone []int
 pistonX []float64
 pistonY []float64
 pistonReach []float64
 pistonDir []float64
 pistonPhase []float64
 pistonLength []float64
 pistonState []int
 relicX []float64
 relicY []float64
 relicTaken []int
 checkpointX []float64
 checkpointY []float64
)
func dist(x,y float64) float64 {return math.Sqrt(x*x+y*y)}
func angle(x,y float64) float64 {return 90-math.Atan2(y,x)*180/3.14159265}
func clamp(v,lo,hi float64) float64 {if v<lo {return lo}; if v>hi {return hi}; return v}
func noise() float64 {fxSeed=(fxSeed*73+41)%997; return float64(fxSeed)/997}
func event(name string) {println "@event",name,elapsed,Hero.px,Hero.py}
func particle(x,y,vx,vy,life,size float64,kind int) {
 if fxCount<70 {fxCount++; Particle.clone []float64{x,y,vx,vy,life,size,float64(kind),float64(attempts)}}
}
func burst(x,y float64,n,kind int,force float64) {
 for i:=0;i<n;i++ {a:=noise()*6.283; speed:=force*(0.3+noise()*0.7); particle(x,y,sin(a)*speed,cos(a)*speed,0.25+noise()*0.45,0.5+noise(),kind)}
}
func ring(x,y,size float64,kind int) {Pulse.clone []float64{x,y,size,float64(kind),float64(attempts)}}
func floorActive(i int) bool {return floorKind[i]!=1 || foldTime>0 || checkpoint>0}
func wallActive(i int) bool {
 if wallGate[i]==0 {return foldTime<=0 && checkpoint==0}
 if wallGate[i]==1 {return switchDone[1]+switchDone[2]<2}
 if wallGate[i]==2 {return switchDone[3]==0 && checkpoint<3}
 return true
}
func visibleLine(ax,ay,bx,by float64) bool {
 for n:=1;n<16;n++ {
  t:=float64(n)/16; x:=ax+(bx-ax)*t; y:=ay+(by-ay)*t
  for j:=0;j<len(wallX);j++ {if wallActive(j) && x>wallX[j] && x<wallX[j]+wallW[j] && y>wallY[j] && y<wallY[j]+wallH[j] {return false}}
 }
 return true
}
func activate(id int) {
 switchDone[id]=1
 if id==0 {foldTime=18; if difficulty==1 {foldTime=12}; event("fold")}
 if id==1 || id==2 {event("valve"); if switchDone[1]+switchDone[2]==2 {event("shaftopen")}}
 if id==3 {liftTime=0.01; event("weight")}
 if id==4 {event("wind")}
 ring(Hero.px,Hero.py+30,1.3,1); burst(Hero.px,Hero.py+30,12,1,170); shock=3
}
func lose(reason int) {
 if phase!=1 || Hero.invulnerable>0 {return}
 phase=3; deaths++; failReason=reason; Hero.hook=-1; burst(Hero.px,Hero.py+30,14,1,190); event("fail")
}
func startRun() {
 attempts++; phase=1; checkpoint=0; deaths=0; collected=0; elapsed=0; hookCount=0; wallJumps=0; worldTime=0; foldTime=0; liftTime=0; shock=0; failReason=0
 for i:=0;i<len(switchDone);i++ {switchDone[i]=0}; for i:=0;i<len(relicTaken);i++ {relicTaken[i]=0}
 for i:=0;i<len(floorY);i++ {floorY[i]=floorBaseY[i]; floorDelta[i]=0}
 Hero.resetHero(checkpointX[0],checkpointY[0]); event("start")
}
func retry() {
 attempts++; phase=1; failReason=0; shock=0
 if checkpoint==0 {foldTime=0; switchDone[0]=0}
 if checkpoint==2 {liftTime=0; switchDone[3]=0}
 for i:=0;i<len(floorY);i++ {floorY[i]=floorBaseY[i]; floorDelta[i]=0}
 Hero.resetHero(checkpointX[checkpoint],checkpointY[checkpoint]); event("retry")
}
func mechanisms(dt float64) {
 worldTime+=dt
 if foldTime>0 {foldTime=math.Max(0,foldTime-dt)}
 if liftTime>0 {liftTime+=dt; if liftTime>16 {liftTime=0}}
 lift:=0.0
 if liftTime>0 && liftTime<5 {lift=liftTime/5} else if liftTime>=5 && liftTime<11 {lift=1} else if liftTime>=11 {lift=(16-liftTime)/5}
 for i:=0;i<len(floorY);i++ {
  old:=floorY[i]; floorY[i]=floorBaseY[i]
  if floorKind[i]==2 {floorY[i]+=lift*530}; if floorKind[i]==3 {floorY[i]-=lift*530}
  floorDelta[i]=floorY[i]-old
 }
 for i:=0;i<len(anchorX);i++ {if anchorKind[i]==2 {offset:=float64(anchorMode[i])*2.4; anchorX[i]=anchorBaseX[i]+sin(worldTime*0.85+offset)*170}}
 cycle:=6.0; if difficulty==1 {cycle=4.6}
 for i:=0;i<len(pistonX);i++ {
  t:=math.Mod(worldTime+pistonPhase[i],cycle); length:=20.0; state:=0
  if t>cycle-2.3 && t<cycle-1.5 {state=1}
  if t>=cycle-1.5 {state=2; travel:=math.Min(1,(t-cycle+1.5)/0.25); if t>cycle-0.5 {travel=(cycle-t)/0.5}; length=20+travel*pistonReach[i]}
  pistonLength[i]=length; pistonState[i]=state
 }
 windStage=0; if switchDone[4]>0 {t:=math.Mod(worldTime,5.8); if t<1 {windStage=1} else if t<4.5 {windStage=2}}
}
func updateWorld(dt float64) {
 elapsed+=dt; shock=math.Max(0,shock-dt*25)
 next:=checkpoint
 if checkpoint==0 && Hero.px>1680 {next=1}
 if checkpoint==1 && Hero.px>2490 && Hero.py< -1250 && switchDone[1]+switchDone[2]==2 {next=2}
 if checkpoint==2 && Hero.px>3830 && Hero.py> -1030 {next=3}
 if checkpoint==3 && Hero.px>5250 {next=4}
 if next!=checkpoint {checkpoint=next; event("checkpoint"); ring(Hero.px,Hero.py+25,1.2,1)}
 for i:=0;i<len(relicX);i++ {if relicTaken[i]==0 && dist(Hero.px-relicX[i],Hero.py+30-relicY[i])<45 {relicTaken[i]=1; collected++; event("relic"); burst(relicX[i],relicY[i],12,1,160)}}
 for i:=0;i<len(pistonX);i++ {
  if pistonState[i]==2 {
   left:=pistonX[i]; if pistonDir[i]<0 {left-=pistonLength[i]}
   if Hero.px+13>left && Hero.px-13<left+pistonLength[i] && Hero.py+52>pistonY[i]-30 && Hero.py<pistonY[i]+30 {lose(2)}
  }
 }
 bottom:=-1650.0; if Hero.px<1600 {bottom=-270}; if Hero.px>3800 && Hero.px<5180 {bottom=-1480}; if Hero.px>5180 {bottom=-1110}
 if Hero.py<bottom {lose(1)}
 if checkpoint==4 && switchDone[4]>0 && Hero.px>5740 && Hero.grounded && Hero.py>=548 && Hero.py<560 {phase=2; Hero.hook=-1; Hero.vx=0; Hero.vy=0; Hero.landing=0; event("finish")}
}
onKey Key1, => {if phase==0 {difficulty=0}}
onKey Key2, => {if phase==0 {difficulty=1}}
onKey KeyR, => {if phase!=0 {startRun()}}
onKey KeyEnter, => {if phase==0 || phase==2 {startRun()} else if phase==3 {retry()} else if phase==4 {phase=1}}
onKey KeyEscape, => {if phase==1 {phase=4} else if phase==4 {phase=1}}
onStart => {
 initLevel(); fxSeed=137; difficulty=0; Hero.resetHero(190,0)
 for i:=0;i<len(floorX);i++ {Ledge.clone i}
 for i:=0;i<len(anchorX);i++ {Anchor.clone i}
 for i:=0;i<len(pistonX);i++ {Piston.clone i}
 for i:=0;i<len(relicX);i++ {Relic.clone i}
 for i:=0;i<18;i++ {Rope.clone i}
 for {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if phase==1 {mechanisms(dt); Hero.update(dt); if phase==1 {updateWorld(dt)}}
  if phase==0 || phase==1 || phase==2 {Hero.render(dt)}
  if float64(timer)-lastState>0.065 {
   lastState=float64(timer)
   grounded:=0; if Hero.grounded {grounded=1}
   println "@state",phase,difficulty,checkpoint,elapsed,deaths,collected,Hero.px,Hero.py,Hero.vx,Hero.vy,Hero.hook,Hero.target,Hero.pull,foldTime,liftTime,switchDone[0],switchDone[1],switchDone[2],switchDone[3],switchDone[4],windStage,attempts,hookCount,wallJumps,grounded,Hero.standing,Hero.dashCool,fxCount,failReason,cameraX,cameraY,worldTime
  }
 }
}
