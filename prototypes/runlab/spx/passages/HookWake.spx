onCloned data => {
 p:=data.([]float64); age:=0.0; x:=p[0]; y:=p[1]
 setXYpos x,y; setHeading angle(p[2],p[3]); setSize p[4]; setGraphicEffect GhostEffect,35; show
 for age<0.26 && int(p[5])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if phase!=4 {age+=dt; x-=p[2]*dt*0.08; y-=p[3]*dt*0.08; setXYpos x,y; t:=clamp(age/0.26,0,1); setGraphicEffect GhostEffect,35+65*t; setSize p[4]*(1+t*0.55)}
 }
 fxCount--; die
}
