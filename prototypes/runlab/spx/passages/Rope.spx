onCloned data => {
 i:=data.(int)
 for {
  waitNextFrame()
  if (phase==1 || phase==4) && (Hero.hook>=0 || Hero.ropeFade>0) {
   a:=float64(i)/36; b:=float64(i+1)/36
   ax:=Hero.ropeX(a); ay:=Hero.ropeY(a); bx:=Hero.ropeX(b); by:=Hero.ropeY(b)
   show; setXYpos (ax+bx)/2,(ay+by)/2; setHeading angle(bx-ax,by-ay)
   setSize clamp(dist(bx-ax,by-ay)/24+0.015,0.13,2)
   ghost:=12.0; if Hero.hook<0 {ghost=30+(1-Hero.ropeFade/0.16)*65}
   setGraphicEffect GhostEffect,ghost
   setGraphicEffect BrightnessEffect,Hero.hookTension*8
  } else {hide}
 }
}
