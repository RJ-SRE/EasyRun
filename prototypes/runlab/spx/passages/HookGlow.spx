onCloned data => {
 p:=data.([]float64); age:=0.0
 setXYpos p[0],p[1]; setHeading p[2]; show
 for age<0.32 && int(p[4])==attempts {
  dt:=float64(waitNextFrame()); if dt>0.035 {dt=0.035}
  if phase!=4 {age+=dt}; t:=clamp(age/0.32,0,1)
  setSize p[3]*(0.7+t*0.8); setGraphicEffect GhostEffect,15+t*85
 }
 die
}
