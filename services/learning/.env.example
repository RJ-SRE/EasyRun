# Copy outside version control. Never put these keys inside .xbp or browser code.
LEARNING_ENV=development
LEARNING_HOST=127.0.0.1
LEARNING_PORT=4190
LEARNING_STORE=local
# Explicit user-selected name profiles. Anyone knowing a name can request it;
# this is not platform authentication. Rename starts a separate archive.
LEARNING_PROFILE_MODE=username
LEARNING_CONTENT_DIR=services/learning/content/legacy-test
LEARNING_DATA_DIR=.local/learning/profiles
LEARNING_JOURNAL_DIR=.local/learning/journal
LEARNING_ALLOWED_ORIGINS=http://127.0.0.1:4177,http://127.0.0.1:4184
# Generate two DIFFERENT random 32-byte secrets. Back up mapping key permanently.
LEARNING_PLAYER_MAPPING_KEY=
LEARNING_SESSION_KEY=
# Fixed official endpoint and issuer, confirmed for this application's credential.
# No user-supplied URL, nickname, public profile lookup or internal AI token.
XBUILDER_USERINFO_URL=
XBUILDER_ISSUER=
# Public BUILD-TIME values only. Blank API URL keeps the .xbp in guest mode.
# The same approved content version must be installed in server and native build.
LEARNING_NATIVE_API_URL=
LEARNING_NATIVE_PROFILE_MODE=username
LEARNING_NATIVE_CONTENT_DIR=
# Production: configure the PRIVATE bucket and uncached origin read channel.
KODO_BUCKET=
KODO_ACCESS_KEY=
KODO_SECRET_KEY=
KODO_UPLOAD_ORIGIN=
KODO_PRIVATE_READ_ORIGIN=
KODO_MANAGEMENT_ORIGIN=https://rs.qiniu.com
KODO_CONTROL_ORIGIN=https://uc.qiniuapi.com
# Discover region-specific HTTPS source/upload/management origins with
# configure-kodo.mjs. The clouddn.com test domain is not used for private profiles.
